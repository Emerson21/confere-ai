# Confere Aí - Environment Variables Template
# NUNCA insira chaves reais neste arquivo. Copie para .env.local para desenvolvimento.

# Google Gemini API Key (para orquestração e síntese do veredito)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Fact Check Tools API Key (opcional, pode usar consulta pública se disponível)
FACT_CHECK_API_KEY=your_fact_check_api_key_here

# Configurações do Ambiente
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
